    },
    {
      "parameters": {
        "jsCode": "// Languages supported by Zoom, see https://developers.zoom.us/docs/api/rest/reference/zoom-api/methods/#operation/webinarRegistrantCreate\nconst language_dictionary = {\n  \"en\": \"en-US\",\n  \"de\": \"de-DE\",\n  \"it\": \"it-IT\"\n}\n\nconst attendeesOriginal = $('When Executed by Another Workflow').all();\n\nlet attendees = [];\nfor (const attendeeOriginal of attendeesOriginal) {\n  const attendee = attendeeOriginal.json.Attendee;\n\n  const lang = language_dictionary[attendee.locale] ?? \"en-US\";\n\n  attendees.push({\n    first_name: attendee.First_Name,\n    last_name: attendee.Last_Name,\n    email: attendee.Email,\n    language: lang\n  });\n}\n\nreturn attendees;\n"
      },
