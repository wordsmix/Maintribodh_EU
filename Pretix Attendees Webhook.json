        "jsCode": "const position_id = $('Webhook').first().json.body.orderposition_id;\n\n// Loop over the attendees from the order\nfor (const item of $input.all()) {\n  \n  // Found the right attendee (by position ID)\n  if (item.json.position_id == position_id) {\n\n    // return minimal data to upsert the record with \"Attended\" status\n    return {\n      Pretix_Position_ID: position_id,\n      Attendance_Status: \"Attended\"\n    }\n  }\n}\n\nreturn {};"
