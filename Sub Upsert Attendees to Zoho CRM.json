    {
      "parameters": {
        "jsCode": "const keyMap = {\n  Name: \"Full_Name\",\n}\n\nconst oldContact = $('Search contact').first().json.data[0];\nconst newContact = $('Prepare Contact data').first().json;\n\nconst nameChanged = oldContact.Full_Name !== newContact.Name;\n\nconst changes = [];\nfor (const [key, value] of Object.entries(newContact)) {\n  const zohoKey = (key in keyMap) ? keyMap[key] : key;\n  let oldValue = oldContact[zohoKey];\n  let newValue = value;\n  if (!oldValue) {\n    continue;\n  }\n  if (value !== oldValue) {\n    if (key === \"Phone\") {\n      oldValue = removeWhiteSpaces(oldValue);\n      newValue = removeWhiteSpaces(value);\n      if (oldValue === newValue) {\n        continue;\n      }\n    }\n    changes.push({\n      key,\n      oldValue: oldValue,\n      newValue: value,\n    })\n  }\n}\n\nlet changesString = '';\nfor (const change of changes) {\n  const string = change.key + ': ' + change.oldValue + ' => ' + change.newValue + \"\\n\";\n  changesString += string;\n}\n\nreturn {nameChanged, changes, changesString};\n\nfunction removeWhiteSpaces(str) {\n  return str.replace(/\\s+/g, '');\n}"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
