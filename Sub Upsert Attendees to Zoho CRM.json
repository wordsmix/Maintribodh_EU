      "id": "ad7b98d9-c0a9-4a8c-ae4f-516c148c5794",
      "name": "Prepare Answer data"
    },
    {
      "parameters": {
        "jsCode": "const SalutationMap = {\n  female: \"Mrs.\",\n  male: \"Mr.\",\n  weblich: \"Mrs.\",\n  männlich: \"Mr.\"\n}\nconst GenderMap = {\n  weiblich: \"female\",\n  männlich: \"male\",\n  divers: \"other\",\n  femminile: \"female\",\n  maschile: \"male\",\n  diverso: \"other\"\n}\nconst languageMap = {\n  \"de\": \"German\",\n  \"de-informal\": \"German\",\n  \"en\": \"English\",\n  \"it\": \"Italian\"\n}\n\n// Translate language from short form (Pretix) to long form (Zoho CRM)\nconst PretixLanguage = $input.first().json.Language;\nconst ZohoLanguage = languageMap[PretixLanguage] ?? PretixLanguage;\n\n// Fail if no e-mail address is given\nif (!$input.first().json.Email) {\n  throw Error('E-Mail is missing.')\n}\n\n// Start to populate data\nlet data = {\n  Email: $input.first().json.Email\n}\n// Fill fields if given and not empty\nif ($input.first().json.First_Name) {\n  data.First_Name = $input.first().json.First_Name;\n}\nif ($input.first().json.Last_Name) {\n  data.Last_Name = $input.first().json.Last_Name;\n}\nif (ZohoLanguage) data.Language = ZohoLanguage;\n// Add name if first name or last name is not empty\nif ($input.first().json.First_Name || $input.first().json.Last_Name) {\n  data.Name = $input.first().json.First_Name + ' ' + $input.first().json.Last_Name;\n}\n// Add Address fields if given and not empty\nif ($input.first().json.address) {\n  const address = $input.first().json.address;\n  if (address?.street)  data.Mailing_Street  = address.street;\n  if (address?.zipcode) data.Mailing_Zip     = address.zipcode;\n  if (address?.city)    data.Mailing_City    = address.city;\n  if (address?.country) data.Mailing_Country = address.country;\n  if (address?.state)   data.Mailing_State   = address.state;\n}\n\n// Salutation + Gender, Phone, Profession, (if not given through normal address field:) Zip_Code, Country or City\nif ($input.first().json.answers) {\n  for (const answer of $input.first().json.answers) {\n    if (answer.question_identifier === 'Gender') {\n      // Add the Salutation field if Gender is given and a recognized value for female or male\n      if (SalutationMap[answer.answer]) data.Salutation = SalutationMap[answer.answer];\n      // Add Gender field\n      data.Gender = GenderMap[answer.answer] ?? answer.answer;\n    } else if (answer.question_identifier === \"Phone\") {\n      data.Phone = answer.answer;\n    } else if (answer.question_identifier === \"Profession\") {\n        data.Profession = answer.answer;\n    } else if (answer.question_identifier === \"Zip_Code\") {\n        data.Mailing_Zip = answer.answer;\n    } else if (answer.question_identifier === \"Country\") {\n      data.Mailing_Country = answer.answer;\n    } else if (answer.question_identifier === \"City\") {\n      data.Mailing_City = answer.answer;\n    }\n  }\n}\n\nreturn data;"
      },
