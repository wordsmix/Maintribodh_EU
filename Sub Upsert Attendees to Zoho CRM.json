      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const answer = {\n    Name : $('Upsert Participation').item.json.data[0].details.id\n      + $json.data[0].id,\n    Event_Participation : $('Upsert Participation').item.json.data[0].details.id ,\n    Question : $json.data[0].id,\n    Answer : $('Loop through answers').item.json.answer\n  }\nreturn answer;"
      },
