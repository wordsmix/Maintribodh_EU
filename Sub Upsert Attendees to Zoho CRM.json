        "jsCode": "const keyMap = {\n  Name: \"Full_Name\",\n}\n\nconst oldContact = $('Search contact by 2 email').first().json.data[0];\nconst newContact = $('Prepare Contact data').first().json;\n\nconst changes = [];\nfor (const [key, value] of Object.entries(newContact)) {\n  const zohoKey = (key in keyMap) ? keyMap[key] : key;\n  console.log('CHecking:', key, zohoKey, value, oldContact[zohoKey]);\n  if (value !== oldContact[zohoKey]) {\n    changes.push({\n      key,\n      oldValue: oldContact[zohoKey],\n      newValue: value,\n    })\n  }\n}\nreturn {changes};"
      },
