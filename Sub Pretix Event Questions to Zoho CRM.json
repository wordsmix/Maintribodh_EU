      "notes": "Get Event Details from Pretix"
    },
    {
      "parameters": {
        "jsCode": "const questions = [];\nfor (const item of $input.all()) {\n  \n  // Take the English question text by default\n  let text = item.json.question?.en;\n\n  // If english is not found or empty, take text from first language with non-empty text\n  if (!text) {\n    for (const textString of Object.values(item.json.question)) {\n      if (textString.length > 0) {\n        text = textString;\n        break;\n      }\n    }\n  }\n  \n  const question = {\n    Name: $('When Executed by Another Workflow').first().json['Pretix Event ID'] + ' ' + item.json.identifier,\n    Question_Text: text,\n    MBP_Event: $('When Executed by Another Workflow').first().json['Zoho Event ID'].toString()\n  }\n  questions.push(question);\n}\n\nreturn questions;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        592,
        0
      ],
      "id": "075e3076-1daf-4b5d-999c-e5d5fa007464",
      "name": "Prepare content for questions"
    },
    {
      "parameters": {
        "jsCode": "return $input.first().json.results;"
