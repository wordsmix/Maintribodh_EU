      "parameters": {
        "jsCode": "const zoom = $input.first().json;\nconst input = $('When Executed by Another Workflow').first().json;\n\nif (!zoom.join_url) {\n  throw new Error('Zoom meeting creation failed - no join_url returned');\n}\n\nreturn {\n  Zoho_Event_ID: input.Zoho_Event_ID,\n  Pretix_Event_ID: input.Pretix_Event_ID,\n  Zoom_Webinar_ID: String(zoom.id)\n//  Zoom_Join_URL: zoom.join_url\n//  Zoom_Start_URL: zoom.start_url,\n//  Zoom_Password: zoom.password || ''\n};"
