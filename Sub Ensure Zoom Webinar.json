    {
      "parameters": {
        "jsCode": "const input = $('When Executed by Another Workflow').first().json;\n\n// Calculate duration in minutes between start and end\nconst start = new Date($('When Executed by Another Workflow').first().json.Event_Start);\nconst end = new Date($('When Executed by Another Workflow').first().json.Event_End);\nconst durationMinutes =  Math.round((end - start) / 60000) ;\n\nconst start_time = new Date($('When Executed by Another Workflow').first().json.Event_Start).toISOString().replace('.000Z', 'Z');\nconst end_time = new Date($('When Executed by Another Workflow').first().json.Event_End).toISOString().replace('.000Z', 'Z');\n\nreturn {\n  access_token: $input.first().json.access_token,\n  meeting_payload: {\n    topic: $('When Executed by Another Workflow').first().json.Event_Name,\n    start_time,\n    end_time,\n    duration: durationMinutes,\n    timezone: input.Event_Timezone || 'Europe/Berlin',\n    settings: {\n      join_before_host: true,\n      waiting_room: false,\n      approval_type: 2,\n      registration_type: 1,\n      auto_recording: 'none'\n    }\n  }\n};"
      },
