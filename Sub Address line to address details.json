        "jsCode": "const address = {}\n\nif ($json.address) {\n  if ($json.address.country_code) {\n    address.country = $json.address.country_code.toUpperCase();\n  }\n  if ($json.address.house_number) {\n    address.street_number = $json.address.house_number;\n  }\n  if ($json.address.road) {\n    address.route = $json.address.road;\n  }\n  if ($json.address.municipality) {\n    address.locality = $json.address.municipality;\n  } else if ($json.address.city) {\n    address.locality = $json.address.city;\n  } else if ($json.address.village) {\n    address.locality = $json.address.village;\n  }\n  if ($json.address.postcode) {\n    address.postal_code = $json.address.postcode;\n  }\n}\n\naddress.latitude = $json.lat;\naddress.longitude = $json.lon;\n\nreturn address;"
      },
