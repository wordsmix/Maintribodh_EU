{
  "name": "Sub Pretix Get Attendees by Order",
  "nodes": [
    {
      "parameters": {
        "jsCode": "let attendees = [];\n\nfor (const item of $input.all()) {\n  \n  const order = item.json;\n  \n  for (const position of order.positions) {\n\n    const attendee = {\n      position_id: String(position.id),\n      order: order.code,\n      event: order.event,\n      zoho_event: $('When Executed by Another Workflow').first().json.Zoho_Event_ID,\n      Email: position.attendee_email,\n      First_Name: position.attendee_name_parts.given_name,\n      Last_Name: position.attendee_name_parts.family_name,\n      locale: $input.first().json.locale,\n      Payment_Status: \"Paid\",\n      Attendance_Status: \"Registered\",\n      invoice_address : $input.first().json.invoice_address,\n      answers : position.answers\n    }\n\n    attendee.address = {};\n\n    if (position.street) attendee.address.street = position.street;\n    if (position.zipcode) attendee.address.zipcode = position.zipcode;\n    if (position.city) attendee.address.city = position.city;\n    if (position.country) attendee.address.country = position.country;\n    if (position.state) attendee.address.state = position.state;\n    \n    attendees.push(attendee);\n  }\n}\n\nreturn attendees;"
      },
