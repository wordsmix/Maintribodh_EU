      "parameters": {
        "jsCode": "// Take the English name by default\nlet name = $input.first().json.name?.en;\n\n// If english is not found or empty, take title from first language with non-empty name\nif (!name) {\n  for (const nameString of Object.values($input.first().json.name)) {\n    if (nameString) {\n      name = nameString;\n      break;\n    }\n  }\n}\n\nconst events = [{\n    Name: name,\n    Pretix_Event_ID: $input.first().json.slug,\n    Event_Start: $input.first().json.date_from,\n    Event_End: $input.first().json.date_to,\n    Status: \"Active\",\n    Location: $input.first().json.location.en,\n    Will_this_need_a_Zoom_Webinar: $input.first().json.meta_data.Will_this_need_a_Zoom_Webinar,\n    Category: $input.first().json.meta_data.Category\n}]\n\nreturn events;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        -80
