    {
      "parameters": {
        "jsCode": "const result = [];\n\n// loop through all rows\nfor (const item of $input.all()) {\n  const event = {\n    Name: item.json.Event_Name,\n    Event_Start: parseDate(item.json.Event_Start),\n    Event_End: parseDate(item.json.Event_End),\n    Event_Location_City: item.json.Event_Location_City,\n    Category: item.json.Category,\n    Related_Tag: item.json.original_tag,\n  }\n\n  // if country is \"Online\", mark Type as Online but add no country\n  if (item.json.Event_Location_Country.toLowerCase() == \"online\") {\n    event.Type = \"Online\";\n  } else {\n    // set country\n    event.Event_Location_Country_Region = item.json.Event_Location_Country;\n  }\n  result.push(event);\n}\n\nreturn {data: result};\n\n/**\n * helper function to parse dates in following formats to datetime strings\n * - YYYY\n * - DD.MM.YYYY\n */\nfunction parseDate(value) {\n  if (!value) return null;\n\n  // trim the value just in case\n  const str = String(value).trim();\n  \n  // only year, e.g. \"2022\"\n  if (/^\\d{4}$/.test(str)) {\n    return (new Date(Date.UTC(Number(str), 0, 0))).toISOString().split('.')[0];\n  }\n  \n  // full date, e.g. \"04.03.2022\" (DD.MM.YYYY)\n  const match = str.match(/^(\\d{1,2})\\.(\\d{1,2})\\.(\\d{4})$/);\n  if (match) {\n    const [, day, month, year] = match;\n    return (new Date(Date.UTC(Number(year), Number(month) - 1, Number(day)))).toISOString().split('.')[0];\n  }\n\n  // fallback\n  return null;\n}"
      },
