    {
      "parameters": {
        "jsCode": "const date = $('When Executed by Another Workflow').first().json['Event Start'].slice(0, 10);//removing the time\n\nlet bodh_field = '';\nconst Bodh_Status_Before = $input.first().json.data[0].Bodh_Status;\nlet Bodh_Status = Bodh_Status_Before;\n\n$('When Executed by Another Workflow').first().json['Event Category'] = \"bodh_1\";\n\nswitch($('When Executed by Another Workflow').first().json['Event Category']) {\n  case \"bodh_1\":\n    bodh_field = \"BODH_1_Date\";\n    Bodh_Status = \"Bodh 1\";\n    break;\n  case \"bodh_2\":\n    bodh_field = \"BODH_2_Date\";\n    Bodh_Status = \"Bodh 2\";\n    break;\n  case \"bodh_3\":\n    bodh_field = \"BODH_3_Date\";\n    Bodh_Status = \"Bodh 3\";\n    break;\n  case \"bodh_4\":\n    bodh_field = \"BODH_4_Date\";\n    Bodh_Status = \"Bodh 4\";\n    break;\n  case \"bodh_5\":\n    bodh_field = \"BODH_5_Date\";\n    Bodh_Status = \"Bodh 5\";\n    break;\n  case \"bodh_6\":\n    bodh_field = \"BODH_6_Date\";\n    Bodh_Status = \"Bodh 6\";\n    break;\n  case \"bodh_7\":\n    bodh_field = \"BODH_7_Date\";\n    Bodh_Status = \"Bodh 7\";\n    break;\n  default:\n    throw Error('unknown Bodh category');\n}\n\nif (Bodh_Status_Before) {\n  // this comparison works as long as we keep the exact naming \"Bodh X\"\n  if (Bodh_Status_Before > Bodh_Status) {\n    Bodh_Status = Bodh_Status_Before;\n  }\n}\n\nreturn {\n  id: $input.first().json.data[0].id,\n  [bodh_field]: date,\n  Bodh_Status\n}\n      "
      },
